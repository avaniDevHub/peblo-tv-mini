# Peblo TV Mini — example environment.
# Copy to `.env` (git-ignored) for local overrides. docker-compose reads it and
# has sane defaults for everything here, so `docker compose up --build` works
# with NO .env file at all. In production these come from a secrets manager,
# never a committed file — see the README "Secrets in production" section.

# ---------- Database ----------
# docker-compose composes DATABASE_URL from these three for the api service.
POSTGRES_USER=peblo
POSTGRES_PASSWORD=peblo          # DEMO ONLY. Real deployments: strong, secret-managed.
POSTGRES_DB=peblo
# The API reads a full SQLAlchemy URL. In compose it's built from the vars above:
#   postgresql+psycopg2://peblo:peblo@db:5432/peblo
# Set it directly when running the API outside compose:
# DATABASE_URL=postgresql+psycopg2://peblo:peblo@localhost:5432/peblo

# ---------- Storage ----------
# "local" writes artwork/catalogue to disk; "r2" uses Cloudflare R2 / any S3 API.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/data/storage
# Browser-facing base URL for media. Local disk => the API serves /media/*.
MEDIA_BASE_URL=http://localhost:8000/media

# --- Only used when STORAGE_BACKEND=r2 (leave blank for local) ---
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public CDN/bucket URL browsers fetch artwork from (falls back to MEDIA_BASE_URL).
R2_PUBLIC_BASE_URL=

# ---------- Auth (demo bearer tokens) ----------
# Map an Authorization: Bearer <token> to a role. In production these are
# replaced by real OIDC/JWT — see the README. Rotate + secret-manage in prod.
EDITOR_TOKEN=editor-token
ADMIN_TOKEN=admin-token

# ---------- App ----------
# Comma-separated CORS allow-list (the two front-ends).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Storage key of the live catalogue pointer.
CATALOG_CURRENT_KEY=catalog/current.json

# ---------- Bootstrap (demo convenience) ----------
# 1 = on first boot, seed then apply the documented fix + publish so the viewer
#     is populated. 0 = seed only; leave the catalogue unpublished to see the
#     genuine empty state / validation gate.
PEBLO_DEMO_PUBLISH=1

# ---------- Front-end build args (Vite, baked at build time) ----------
# The browser runs on the host, so these must be host-reachable, not the
# docker-internal "api" hostname.
VITE_API_BASE=http://localhost:8000
